# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env itself.
# .env is already listed in .gitignore.
# =============================================================================

# ---- CognoDB Cloud (free c0 instance) -------------------------------------
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# ---- Neo4j AuraDB Free ------------------------------------------------------
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- Memgraph (Memgraph Cloud free trial OR self-hosted docker-compose) ----
# If using docker-compose.yml as-is, the default below already matches it.
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ---- FalkorDB (FalkorDB Cloud free tier OR self-hosted docker-compose) -----
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=

# ---- ArangoDB (ArangoDB Oasis free trial OR self-hosted docker-compose) ----
ARANGODB_URI=http://localhost:8529
ARANGODB_USER=root
ARANGODB_PASSWORD=changeme
ARANGODB_DB=benchmark

# ---- Benchmark parameters (shared across all platforms) --------------------
BENCH_ITERATIONS=100          # read-workload iterations after warmup
BENCH_WARMUP=20                # discarded warmup iterations per workload
BENCH_CONCURRENCY_LEVELS=1,10,40
BENCH_MIXED_DURATION_SEC=30    # duration of each concurrency sweep step
BENCH_READ_WRITE_RATIO=0.8     # fraction of mixed-workload ops that are reads
BENCH_TRAVERSAL_SAMPLE_SIZE=50 # number of random start nodes per hop depth
BENCH_RANDOM_SEED=42
